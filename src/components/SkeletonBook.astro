</div>
 
<style>
  .skeleton-book {
    width: 100%;
    height: 800px;
    background-color: var(--skeleton-background);
    display: flex;
    align-items: center;
    justify-content: center;
  }
 
  .skeleton-book-wrapper {
    height: 100%;
    width: 100%;
    max-width: 1180px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
 
  .cover-container-wrapper-skeleton {
    position: relative;
    width: 456px;
    height: 653px;
  }
 
  .cover-container-skeleton {
    height: 653px;
    width: 456px;
    position: absolute;
    top: 0;
    left: -20px;
    z-index: 2;
    overflow: hidden;
  }
 
  /* --------------------------- GLITCH --------------------------- */
  /* .glitch-cover wypełnia zawsze 100% cover-container-skeleton,
     więc na każdym breakpoincie poniżej dostaje właściwy rozmiar
     bez potrzeby dublowania media queries */
 
  .glitch-cover {
    --gap-horizontal: 10px;
    --gap-vertical: 5px;
    --time-anim: 4s;
    --delay-anim: 2s;
    --blend-mode-2: none;
    --blend-mode-3: none;
    --blend-mode-4: none;
    --blend-mode-5: overlay;
    --blend-color-2: transparent;
    --blend-color-3: transparent;
    --blend-color-4: transparent;
    --blend-color-5: #af4949;
 
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
 
  .glitch-cover .glitch__item-cover {
    background-image: var(--cover-image);
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
 
  .glitch-cover .glitch__item-cover:nth-child(n + 2) {
    opacity: 0;
    animation-duration: var(--time-anim);
    animation-delay: var(--delay-anim);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
 
  .glitch-cover .glitch__item-cover:nth-child(2) {
    background-color: var(--blend-color-2);
    background-blend-mode: var(--blend-mode-2);
    animation-name: glitch-anim-2;
  }
 
  /* poprawka: w oryginale było znowu nth-child(2) -
     glitch-anim-3 nigdy się nie odpalał */
  .glitch-cover .glitch__item-cover:nth-child(3) {
    background-color: var(--blend-color-3);
    background-blend-mode: var(--blend-mode-3);
    animation-name: glitch-anim-3;
  }
 
  .glitch-cover .glitch__item-cover:nth-child(4) {
    background-color: var(--blend-color-4);
    background-blend-mode: var(--blend-mode-4);
    animation-name: glitch-anim-4;
  }
 
  .glitch-cover .glitch__item-cover:nth-child(5) {
    background-color: var(--blend-color-5);
    background-blend-mode: var(--blend-mode-5);
    animation-name: glitch-anim-flash;
  }
 
  .book-read-container-skeleton {
    height: 90%;
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 45px;
  }
 
  .skeleton-buttons-wrapper {
    height: 100px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 80px;
  }
 
  .skeleton-download-button {
    cursor: pointer;
    font-family: "Manrope";
    font-weight: 400;
    color: white;
    transition: all 0.2s;
    padding: 10px 20px;
    border-radius: 100px;
    background: var(--skeleton-accent);
    border: 1px solid transparent;
    display: flex;
    align-items: center;
    font-size: 16px;
  }
 
  .skeleton-download-button:hover {
    background: #B8334A;
  }
 
  .skeleton-download-button > svg {
    width: 23px;
    margin-left: 10px;
    transition: transform 0.3s ease-in-out;
  }
 
  .skeleton-download-button:hover svg {
    transform: translateX(5px);
  }
 
  .skeleton-download-button:active {
    transform: scale(0.95);
  }
 
  .skeleton-description {
    width: 100%;
    height: 200px;
    padding: 20px 85px;
  }
 
  .skeleton-description p {
    color: var(--skeleton-text);
    font-size: 19px;
  }
 
  /* ---------------------------- 1200 px ---------------------------------- */
 
  @media screen and (max-width: 1200px) {
    .skeleton-book-wrapper {
      max-width: 1100px;
    }
 
    .cover-container-wrapper-skeleton {
      position: relative;
      width: 402px;
      height: 575px;
    }
 
    .cover-container-skeleton {
      height: 575px;
      width: 402px;
    }
 
    .cover-plate-skeleton {
      height: 575px;
      width: 402px;
    }
 
    .skeleton-buttons-wrapper {
      padding: 0 40px;
    }
 
    .skeleton-description {
      padding: 20px 60px;
    }
  }
 
  /* ---------------------------- 1100 px ---------------------------------- */
 
  @media screen and (max-width: 1100px) {
    .skeleton-book {
      height: 700px;
    }
 
    .skeleton-book-wrapper {
      max-width: 1000px;
    }
 
    .cover-container-wrapper-skeleton {
      width: 367px;
      height: 525px;
    }
 
    .cover-container-skeleton {
      height: 525px;
      width: 367px;
    }
 
    .cover-plate-skeleton {
      height: 525px;
      width: 367px;
    }
 
    .book-read-container-skeleton {
      padding-top: 35px;
    }
 
    .skeleton-description {
      padding: 10px 50px;
    }
 
    .skeleton-description p {
      font-size: 17px;
    }
  }
 
  /* ---------------------------- 1000 px ---------------------------------- */
 
  @media screen and (max-width: 1000px) {
    .skeleton-buttons-wrapper {
      height: auto;
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 15px;
      padding-top: 25px;
    }
 
    .skeleton-description {
      padding: 10px 40px;
    }
 
    .skeleton-description p {
      font-size: 16px;
    }
  }
 
  /* ---------------------------- 950 px ---------------------------------- */
 
  @media screen and (max-width: 950px) {
    .skeleton-book {
      height: 1400px;
    }
 
    .skeleton-book-wrapper {
      flex-direction: column;
    }
 
    .skeleton-buttons-wrapper {
      flex-direction: row;
      justify-content: space-around;
      align-items: center;
      width: 500px;
    }
 
    .book-read-container-skeleton {
      margin-top: 340px;
      width: 600px;
    }
 
    .cover-container-wrapper-skeleton {
      position: relative;
      width: 439px;
      height: 628px;
      margin-top: 50px;
    }
 
    .cover-container-skeleton {
      height: 628px;
      width: 439px;
    }
 
    .cover-plate-skeleton {
      height: 628px;
      width: 439px;
    }
 
    .skeleton-description {
      margin-top: 30px;
      padding: 10px 50px;
    }
 
    .skeleton-description p {
      font-size: 19px;
    }
  }
 
  /* ---------------------------- 615 px ---------------------------------- */
 
  @media screen and (max-width: 615px) {
    .skeleton-book {
      height: 1375px;
    }
 
    .cover-container-wrapper-skeleton {
      width: 402px;
      height: 575px;
      margin-top: 60px;
    }
 
    .cover-container-skeleton {
      height: 575px;
      width: 402px;
    }
 
    .cover-plate-skeleton {
      height: 575px;
      width: 402px;
    }
 
    .book-read-container-skeleton {
      margin-top: 280px;
      width: 500px;
    }
 
    .skeleton-description {
      margin-top: 30px;
      padding: 10px 35px;
    }
  }
 
  /* ---------------------------- 515 px ---------------------------------- */
 
  @media screen and (max-width: 515px) {
    .skeleton-book {
      height: 1340px;
    }
 
    .cover-container-wrapper-skeleton {
      width: 315px;
      height: 450px;
      margin-top: 60px;
    }
 
    .cover-container-skeleton {
      height: 450px;
      width: 315px;
    }
 
    .cover-plate-skeleton {
      height: 450px;
      width: 315px;
    }
 
    .skeleton-buttons-wrapper {
      height: auto;
      width: 100%;
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 15px;
      padding: 0 25px;
      padding-top: 5px;
    }
 
    .book-read-container-skeleton {
      margin-top: 170px;
      width: 415px;
    }
 
    .skeleton-description {
      margin-top: 10px;
      padding: 10px 25px;
    }
  }
 
  /* ---------------------------- 430 px ---------------------------------- */
 
  @media screen and (max-width: 430px) {
    .skeleton-book {
      height: 1310px;
    }
 
    .cover-container-wrapper-skeleton {
      width: 300px;
      height: 429px;
      margin-top: 60px;
    }
 
    .cover-container-skeleton {
      height: 429px;
      width: 300px;
    }
 
    .cover-plate-skeleton {
      height: 429px;
      width: 300px;
      top: 20px;
      right: 20px;
    }
 
    .book-read-container-skeleton {
      margin-top: 135px;
      width: 100%;
    }
 
    .skeleton-description {
      margin-top: 5px;
      padding: 10px 35px;
    }
 
    .skeleton-buttons-wrapper {
      padding: 0 35px;
      padding-top: 20px;
    }
  }
 
  /* ---------------------------- 400 px ---------------------------------- */
 
  @media screen and (max-width: 400px) {
    .skeleton-book {
      height: 1400px;
    }
 
    .cover-plate-skeleton {
      display: none;
    }
 
    .cover-container-wrapper-skeleton {
      width: 320px;
      height: 458px;
      margin-top: 60px;
    }
 
    .cover-container-skeleton {
      height: 458px;
      width: 320px;
    }
  }
 
  /* --------------------- GLITCH: keyframes --------------------- */
 
  @keyframes glitch-anim-flash {
    0%,
    5% {
      opacity: 0.2;
      transform: translate3d(var(--gap-horizontal), var(--gap-vertical), 0);
    }
    5.5%,
    100% {
      opacity: 0;
      transform: translate3d(0, 0, 0);
    }
  }
 
  @keyframes glitch-anim-2 {
    0% {
      opacity: 1;
      transform: translate3d(var(--gap-horizontal), 0, 0);
      clip-path: polygon(0 2%, 100% 2%, 100% 5%, 0 5%);
    }
    2% {
      clip-path: polygon(0 15%, 100% 15%, 100% 15%, 0 15%);
    }
    4% {
      clip-path: polygon(0 10%, 100% 10%, 100% 20%, 0 20%);
    }
    6% {
      clip-path: polygon(0 1%, 100% 1%, 100% 2%, 0 2%);
    }
    8% {
      clip-path: polygon(0 33%, 100% 33%, 100% 33%, 0 33%);
    }
    10% {
      clip-path: polygon(0 44%, 100% 44%, 100% 44%, 0 44%);
    }
    12% {
      clip-path: polygon(0 50%, 100% 50%, 100% 20%, 0 20%);
    }
    14% {
      clip-path: polygon(0 70%, 100% 70%, 100% 70%, 0 70%);
    }
    16% {
      clip-path: polygon(0 80%, 100% 80%, 100% 80%, 0 80%);
    }
    18% {
      clip-path: polygon(0 50%, 100% 50%, 100% 55%, 0 55%);
    }
    20% {
      clip-path: polygon(0 70%, 100% 70%, 100% 80%, 0 80%);
    }
    21.9% {
      opacity: 1;
      transform: translate3d(var(--gap-horizontal), 0, 0);
    }
    22%,
    100% {
      opacity: 0;
      transform: translate3d(0, 0, 0);
      clip-path: polygon(0 0, 0 0, 0 0, 0 0);
    }
  }
 
  @keyframes glitch-anim-3 {
    0% {
      opacity: 1;
      transform: translate3d(calc(-1 * var(--gap-horizontal)), 0, 0);
      clip-path: polygon(0 25%, 100% 25%, 100% 30%, 0 30%);
    }
    3% {
      clip-path: polygon(0 3%, 100% 3%, 100% 3%, 0 3%);
    }
    5% {
      clip-path: polygon(0 5%, 100% 5%, 100% 20%, 0 20%);
    }
    7% {
      clip-path: polygon(0 20%, 100% 20%, 100% 20%, 0 20%);
    }
    9% {
      clip-path: polygon(0 40%, 100% 40%, 100% 40%, 0 40%);
    }
    11% {
      clip-path: polygon(0 52%, 100% 52%, 100% 59%, 0 59%);
    }
    13% {
      clip-path: polygon(0 60%, 100% 60%, 100% 60%, 0 60%);
    }
    15% {
      clip-path: polygon(0 75%, 100% 75%, 100% 75%, 0 75%);
    }
    17% {
      clip-path: polygon(0 65%, 100% 65%, 100% 40%, 0 40%);
    }
    19% {
      clip-path: polygon(0 45%, 100% 45%, 100% 50%, 0 50%);
    }
    20% {
      clip-path: polygon(0 14%, 100% 14%, 100% 33%, 0 33%);
    }
    21.9% {
      opacity: 1;
      transform: translate3d(calc(-1 * var(--gap-horizontal)), 0, 0);
    }
    22%,
    100% {
      opacity: 0;
      transform: translate3d(0, 0, 0);
      clip-path: polygon(0 0, 0 0, 0 0, 0 0);
    }
  }
 
  @keyframes glitch-anim-4 {
    0% {
      opacity: 1;
      transform: translate3d(0, calc(-1 * var(--gap-vertical)), 0)
        scale3d(-1, -1, 1);
      clip-path: polygon(0 1%, 100% 1%, 100% 3%, 0 3%);
    }
    1.5% {
      clip-path: polygon(0 10%, 100% 10%, 100% 9%, 0 9%);
    }
    2% {
      clip-path: polygon(0 5%, 100% 5%, 100% 6%, 0 6%);
    }
    2.5% {
      clip-path: polygon(0 20%, 100% 20%, 100% 20%, 0 20%);
    }
    3% {
      clip-path: polygon(0 10%, 100% 10%, 100% 10%, 0 10%);
    }
    5% {
      clip-path: polygon(0 30%, 100% 30%, 100% 25%, 0 25%);
    }
    5.5% {
      clip-path: polygon(0 15%, 100% 15%, 100% 16%, 0 16%);
    }
    7% {
      clip-path: polygon(0 40%, 100% 40%, 100% 39%, 0 39%);
    }
    8% {
      clip-path: polygon(0 20%, 100% 20%, 100% 21%, 0 21%);
    }
    9% {
      clip-path: polygon(0 60%, 100% 60%, 100% 55%, 0 55%);
    }
    10.5% {
      clip-path: polygon(0 30%, 100% 30%, 100% 31%, 0 31%);
    }
    11% {
      clip-path: polygon(0 70%, 100% 70%, 100% 69%, 0 69%);
    }
    13% {
      clip-path: polygon(0 40%, 100% 40%, 100% 41%, 0 41%);
    }
    14% {
      clip-path: polygon(0 80%, 100% 80%, 100% 75%, 0 75%);
    }
    14.5% {
      clip-path: polygon(0 50%, 100% 50%, 100% 51%, 0 51%);
    }
    15% {
      clip-path: polygon(0 90%, 100% 90%, 100% 90%, 0 90%);
    }
    16% {
      clip-path: polygon(0 60%, 100% 60%, 100% 60%, 0 60%);
    }
    18% {
      clip-path: polygon(0 100%, 100% 100%, 100% 99%, 0 99%);
    }
    20% {
      clip-path: polygon(0 70%, 100% 70%, 100% 71%, 0 71%);
    }
    21.9% {
      opacity: 1;
      transform: translate3d(0, calc(-1 * var(--gap-vertical)), 0)
        scale3d(-1, -1, 1);
    }
    22%,
    100% {
      opacity: 0;
      transform: translate3d(0, 0, 0);
      clip-path: polygon(0 0, 0 0, 0 0, 0 0);
    }
  }
</style>
 
