---
import czarusiaBackground from "../assets/images/czarusia_background.webp";
---

<div
  class="czarusia-wrapper"
  style={`background-image: url(${czarusiaBackground.src});`}
>
  <div class="czarusia-text">
    <p>Kryminał z&nbsp;czarną kotką w&nbsp;roli głownej</p>
    <p><b>Coming Soon</b></p>
  </div>
</div>

<style>
  .czarusia-wrapper {
    height: 800px;
    width: 100%;
    background-color: #141e30; /* fallback zanim obrazek się załaduje */
    background-size: cover;
    background-position: center top;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .czarusia-text {
    display: flex;
    flex-direction: column;
    padding-right: 80px;
  }

  .czarusia-text p {
    font-size: 32px;
    color: var(--light-text-color);
    font-family: "Manrope";
    font-weight: 300;
  }
</style>
